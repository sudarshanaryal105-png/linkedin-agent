# Copy this file to .env and fill in real values. Never commit the real .env.

# --- App ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development

# --- Supabase (Project Settings -> API, and Project Settings -> Database) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_STORAGE_BUCKET=post-images
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- LinkedIn Developer App (developer.linkedin.com/apps -> your app -> Auth tab) ---
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
LINKEDIN_API_VERSION=202607

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Quotas ---
MAX_UPLOAD_MB=15
MAX_IMAGES_PER_GENERATION=6
DAILY_GENERATION_QUOTA_PER_USER=30
